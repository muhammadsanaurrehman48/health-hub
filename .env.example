# Frontend Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# API Configuration
# Leave empty or omit to auto-detect based on current hostname
# Set this if your API is on a different host/port than the frontend
# VITE_API_URL=http://localhost:5000/api

# Application Environment
VITE_APP_ENV=development

# Optional: Analytics/Monitoring
# VITE_SENTRY_DSN=your-sentry-dsn
# VITE_SEGMENT_WRITE_KEY=your-segment-key

# Optional: Feature Flags
# VITE_ENABLE_DEMO_MODE=false
# VITE_ENABLE_DEV_TOOLS=false
